config_version=5
[application]
config/name="Modern Rooms & People — Pro Cast"
run/main_scene="res://godot-demo/main.tscn"
[display]
window/size/viewport_width=576
window/size/viewport_height=384
window/size/window_width_override=1152
window/size/window_height_override=768
window/stretch/mode="canvas_items"
[rendering]
renderer/rendering_method="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.239,0.282,0.357,1)
